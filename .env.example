# MatrixFleet — environment variables
# Copy to .env.local for development. NEVER commit real values: .env* files are git-ignored
# (only this example is tracked). In production, set them in Vercel → Settings → Environment Variables.
#
# PUBLIC  = prefixed NEXT_PUBLIC_, compiled into the browser bundle. Only values that are safe
#           for anyone to see may use this prefix.
# SERVER  = never sent to the browser. Mark these "Sensitive" in Vercel.

# ── Supabase (self-hosted, London) ───────────────────────────────────────────
# PUBLIC: HTTPS address of the Supabase API gateway.
NEXT_PUBLIC_SUPABASE_URL=https://api.your-domain.example
# PUBLIC: anon key. Safe in the browser ONLY because every MatrixFleet table has
# row-level security enabled and anon has no table grants (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# PUBLIC: Postgres schema holding the MatrixFleet tables (must be in PGRST_DB_SCHEMAS on the server).
NEXT_PUBLIC_SUPABASE_SCHEMA=matrixfleet
# SERVER: service role key — bypasses row-level security. Server code only (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SERVER: shared secret. The API gateway (Caddy) rejects password sign-in, sign-up and email-link
# calls without it, so credential attempts can only go through this app and its rate limits.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SUPABASE_AUTH_GATEWAY_KEY=your-random-32-plus-character-secret

# ── App ──────────────────────────────────────────────────────────────────────
# PUBLIC
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MatrixFleet

# ── Stripe ───────────────────────────────────────────────────────────────────
# SERVER: secret key (sk_test_… in development, sk_live_… in production).
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# SERVER: signing secret of the webhook endpoint …/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# SERVER: price IDs (not secret, but only the server needs them). Must start with price_.
STRIPE_PRICE_STARTER_GBP=price_xxx
STRIPE_PRICE_STARTER_EUR=price_xxx
STRIPE_PRICE_GROWTH_GBP=price_xxx
STRIPE_PRICE_GROWTH_EUR=price_xxx
STRIPE_PRICE_PRO_GBP=price_xxx
STRIPE_PRICE_PRO_EUR=price_xxx
# One extra vehicle per month above the plan's included vehicles (per-unit, monthly).
STRIPE_PRICE_GROWTH_EXTRA_VEHICLE_GBP=price_xxx
STRIPE_PRICE_GROWTH_EXTRA_VEHICLE_EUR=price_xxx
STRIPE_PRICE_PRO_EXTRA_VEHICLE_GBP=price_xxx
STRIPE_PRICE_PRO_EXTRA_VEHICLE_EUR=price_xxx
# SERVER: secret Vercel Cron sends to /api/cron/billing-sync (daily extra-vehicle reconciliation). 32+ chars.
CRON_SECRET=your-random-32-plus-character-secret
# (No Stripe publishable key is needed: checkout runs on Stripe's hosted page.)

# ── Maps / routing ───────────────────────────────────────────────────────────
# SERVER: public OpenStreetMap services by default; use self-hosted or paid ones in production.
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# SERVER: map tile provider, fetched by /api/tiles (browsers never contact it; an API key here stays secret).
# Default: OpenStreetMap (testing only). Production example: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
MAP_TILE_URL=
# PUBLIC: map attribution text if you change provider (HTML allowed)
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ── Optional: direct Postgres login (reports/backups only, never used by the web app) ──
# SERVER: connection strings contain a password.
MATRIXFLEET_DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
MATRIXFLEET_DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Saudi e-invoicing (ZATCA Phase 2). Encrypts each Saudi company's signing key and ZATCA credentials at rest.
# 64 hex characters (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it once companies are connected (their keys could no longer be decrypted). Leave empty to disable ZATCA.
ZATCA_ENCRYPTION_KEY=

# ── Document emails (invoices, credit notes, CMR sent as PDF attachments) ───────
# SERVER: SMTP mailbox that sends them, e.g. Zoho: smtp.zoho.com, 587, info@your-domain, an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
