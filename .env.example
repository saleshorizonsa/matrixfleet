# --- Supabase (self-hosted, London) ---
# Public URL of your Supabase API gateway (Kong). Must be reachable over HTTPS from Vercel
# and from drivers' phones, e.g. https://api.yourdomain.com. For local dev through the SSH
# tunnel use http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres schema holding the MatrixFleet tables (must be listed in PGRST_DB_SCHEMAS on the server)
NEXT_PUBLIC_SUPABASE_SCHEMA=matrixfleet
# Server only — never expose. Used by the Stripe webhook and GDPR erasure.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MatrixFleet

# --- Stripe (use test keys in development) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (create in Stripe dashboard: one monthly price per plan per currency)
STRIPE_PRICE_STARTER_GBP=
STRIPE_PRICE_GROWTH_GBP=
STRIPE_PRICE_PRO_GBP=
STRIPE_PRICE_STARTER_EUR=
STRIPE_PRICE_GROWTH_EUR=
STRIPE_PRICE_PRO_EUR=
# Price for ONE extra vehicle per month above the plan's included vehicles (per-unit, recurring monthly)
STRIPE_PRICE_GROWTH_EXTRA_VEHICLE_GBP=
STRIPE_PRICE_GROWTH_EXTRA_VEHICLE_EUR=
STRIPE_PRICE_PRO_EXTRA_VEHICLE_GBP=
STRIPE_PRICE_PRO_EXTRA_VEHICLE_EUR=

# --- Maps / routing (defaults use public OpenStreetMap services; swap for paid ones in production) ---
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Optional: direct Postgres login for reports/backups (never used by the web app) ---
MATRIXFLEET_DATABASE_URL=
MATRIXFLEET_DIRECT_URL=
