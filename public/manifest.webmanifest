    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "My jobs", "url": "/driver", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Vehicle check", "url": "/driver/check", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shift", "url": "/driver/shift", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
